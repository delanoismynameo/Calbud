# Supabase URL (get from your project settings)
VITE_SUPABASE_URL=
# Supabase anon/public key (get from your project settings)
VITE_SUPABASE_PUBLISHABLE_KEY=
# USDA food search API key (free from api.data.gov — "DEMO_KEY" used when empty)
VITE_USDA_API_KEY=
# VAPID public key for web push notifications (generate with: npx @web-push/cli)
VITE_VAPID_KEY=